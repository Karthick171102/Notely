# Supabase Configuration
# These values should be set via Vercel Dashboard > Settings > Environment Variables
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Settings > API > Project API keys
# 3. Copy the values below

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side Supabase credentials (also available to frontend via VITE_ prefix)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Application
PORT=4000
NODE_ENV=development